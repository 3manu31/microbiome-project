# Supabase configuration for chart caching
# Rename this file to secrets.toml and add your actual Supabase credentials

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-anon-public-key-here"

# Note: 
# - You need to create a bucket named "chart_cache" in your Supabase storage
# - Make sure the bucket has the appropriate permissions for your use case
# - The anon key should have permission to read/write to the chart_cache bucket
